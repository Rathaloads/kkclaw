{
  "name": "kkclaw",
  "version": "1.0.0",
  "description": "",
  "bin": {
    "kkclaw": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch --env-file .env.development.local src/index.ts",
    "build": "pnpm run clean && tsc",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "start:dev": "tsx --env-file .env.development.local ./src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.6.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "watch": "^1.0.2"
  },
  "dependencies": {
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
